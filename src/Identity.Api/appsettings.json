{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=identity;Username=identity;Password=identity",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "identity",
    "Audience": "identity",
    "AccessTokenMinutes": 15
  },
  "Auth": {
    "RefreshTokenDays": 30,
    "RefreshGraceSeconds": 5,
    "VerificationCodeMinutes": 15,
    "VerificationResendCooldownSeconds": 60,
    "VerificationWindowMinutes": 60,
    "VerificationMaxSendsPerWindow": 5,
    "VerificationMaxAttempts": 10,
    "PasswordResetMinutes": 30,
    "PasswordResetCooldownSeconds": 60,
    "PasswordResetUrl": "",
    "LoginMaxFailures": 10,
    "LoginFailureWindowMinutes": 15,
    "LoginLockoutMinutes": 15
  },
  "PasswordHashing": {
    "MemoryKb": 65536,
    "Iterations": 3,
    "Parallelism": 4,
    "MaxConcurrent": 8,
    "QueueTimeoutSeconds": 5
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "UseStartTls": true,
    "From": "Identity <no-reply@identity.local>"
  },
  "RateLimiting": {
    "StrictPermitLimit": 5,
    "PermitLimit": 10
  },
  "Seed": {
    "AdminEmail": "",
    "AdminPassword": ""
  }
}
